# Copy to .env for local development. On Vercel these are set in Project -> Settings -> Environment Variables.

# Postgres connection string. On Vercel the Neon integration adds this for you.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random text. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# First-run admin account (created only if no admin exists yet).
# If ADMIN_PASSWORD is empty, a random one is printed once in the server log.
ADMIN_ID=admin
ADMIN_PASSWORD=

# Optional: private Vercel Blob token, to store uploaded reviewers outside the database when running locally.
# (On Vercel, connecting a Blob store to the project is enough.)
# BLOB_READ_WRITE_TOKEN=

# Optional: push updates through Neon Realtime instead of polling (see README, "Live updates").
# Neon Console -> your project -> Postgres database -> Realtime -> Enable Realtime, then copy both values.
# NEON_REALTIME_URL=
# NEON_REALTIME_SECRET=
# Only if your database is not the one named in DATABASE_URL:
# NEON_REALTIME_DB=neondb
